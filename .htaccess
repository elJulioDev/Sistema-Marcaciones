# ── Front controller: reenvía todo a public/ ─────────────────────
# La migración está completa: no quedan archivos planos en la raíz.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Raíz del proyecto → front controller
    RewriteRule ^$ public/index.php [L]

    # Assets (public/assets/*) → directo, sin pasar por PHP
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Todo lo demás → front controller
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
