# Copia este archivo a .env y ajusta los valores según tu entorno.
# El archivo .env NO se versiona (ver .gitignore).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=marcaciones
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Sin barra final. Vacío si vive en raíz del dominio.
BASE_URL=/Sistema-Marcaciones

# local | production
APP_ENV=production
